  "beatTimings": {
    "b1": {
      "startSec": 0.15,
      "endSec": 3.063,
      "startFrame": 4,
      "endFrame": 92,
      "text": "In this town, the loudest kid becomes the mayor for a day."
    },
    "b2": {
      "startSec": 3.143,
      "endSec": 6.835,
      "startFrame": 94,
      "endFrame": 205,
      "text": "Every morning in the park, everyone shouts at the sky as hard as they can."
    },
    "b3": {
      "startSec": 6.915,
      "endSec": 11.415,
      "startFrame": 207,
      "endFrame": 342,
      "text": "And every single day, the same kid wins. Rocky, the kid with the megaphone voice."
    },
    "b4": {
      "startSec": 11.495,
      "endSec": 15.228,
      "startFrame": 345,
      "endFrame": 457,
      "text": "I'm Leo, the quietest kid in school, so nobody ever hears my name."
    },
    "b5": {
      "startSec": 15.308,
      "endSec": 19.752,
      "startFrame": 459,
      "endFrame": 593,
      "text": "Rocky's first rule as mayor: candy for loud kids, nothing for quiet kids."
    },
    "b6": {
      "startSec": 19.832,
      "endSec": 22.492,
      "startFrame": 595,
      "endFrame": 675,
      "text": "So my little sister Mia and I made a plan to beat him."
    },
    "b7": {
      "startSec": 22.572,
      "endSec": 25.429,
      "startFrame": 677,
      "endFrame": 763,
      "text": "On contest day, Rocky took the biggest breath of his life."
    },
    "b8": {
      "startSec": 25.509,
      "endSec": 28.552,
      "startFrame": 765,
      "endFrame": 857,
      "text": "He screamed so hard that his voice cracked, and then it was gone."
    },
    "b9": {
      "startSec": 28.632,
      "endSec": 32.173,
      "startFrame": 859,
      "endFrame": 965,
      "text": "The principal said the next loudest kid wins. Nobody made a sound."
    },
    "b10": {
      "startSec": 32.253,
      "endSec": 34.616,
      "startFrame": 968,
      "endFrame": 1038,
      "text": "Then Mia pointed at me, and the whole crowd turned."
    },
    "w1": {
      "startSec": 34.816,
      "endSec": 35.447,
      "startFrame": 1044,
      "endFrame": 1063,
      "text": "LEO!"
    },
    "w2": {
      "startSec": 35.697,
      "endSec": 36.161,
      "startFrame": 1071,
      "endFrame": 1085,
      "text": "IS!"
    },
    "w3": {
      "startSec": 36.411,
      "endSec": 37.02,
      "startFrame": 1092,
      "endFrame": 1111,
      "text": "MAYOR!"
    },
    "b11": {
      "startSec": 37.27,
      "endSec": 40.242,
      "startFrame": 1118,
      "endFrame": 1207,
      "text": "My first law: free candy for every quiet kid in town."
    },
    "b12": {
      "startSec": 40.322,
      "endSec": 44.582,
      "startFrame": 1210,
      "endFrame": 1337,
      "text": "But this morning, Rocky whispered one sentence in my ear, and I heard every word."
    }
  },
